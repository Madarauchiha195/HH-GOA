# ─────────────────────────────────────────────────────────────
#  HH Goa 2026 — Voice-Enabled RAG  |  Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── API Keys ──────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Embedding & Retrieval ─────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large
VECTOR_DB_PATH=data/indexes/faiss.index
BM25_INDEX_PATH=data/indexes/bm25.pkl
METADATA_PATH=data/indexes/metadata.json
CHUNK_TEXT_PATH=data/indexes/chunks.json

# ── Reranker ──────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# ── Retrieval Parameters ──────────────────────────────────────
TOP_K_DENSE=30
TOP_K_BM25=30
TOP_K_FUSED=15
TOP_K_RERANK=5
RRF_K=60
RETRIEVAL_CONFIDENCE_THRESHOLD=0.3

# ── Generation ────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# ── Performance ───────────────────────────────────────────────
FAST_MODE=false
REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32

# ── Dataset (Ingestion) ───────────────────────────────────────
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_SAMPLE_SIZE=10000
DATASET_LANGUAGES=en,hi,kn,mr
CHUNK_STRATEGY=sliding_window
CHUNK_SIZE=256
CHUNK_OVERLAP=64

# ── Application ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Sarvam STT ───────────────────────────────────────────────
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MAX_RETRIES=3
SARVAM_STT_TIMEOUT=15
